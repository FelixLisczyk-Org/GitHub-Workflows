#!/usr/bin/env bash
# Stand-in for `lsof -a -c xcodebuild -d cwd -F pcn`, printing the working
# directories of a fixed set of processes in lsof's field format.
#
# Every call lists processes that must not hold the step: the runner hook's
# `caffeinate` and an `xcodebuild-helper` (matched by `-c` as a prefix) inside
# the workspace, and an `xcodebuild` in a directory that only shares the
# workspace path as a prefix. The first `FAKE_LSOF_BUSY_CALLS` calls also list a
# leftover `xcodebuild` inside the workspace; a negative value lists it on every
# call.
set -uo pipefail

: "${FAKE_LSOF_STATE_DIR:?FAKE_LSOF_STATE_DIR is required}"
: "${FAKE_LSOF_WORKSPACE:?FAKE_LSOF_WORKSPACE is required}"
busy_calls="${FAKE_LSOF_BUSY_CALLS:-0}"

mkdir -p "${FAKE_LSOF_STATE_DIR}"
calls_file="${FAKE_LSOF_STATE_DIR}/calls"
calls=$(($(cat "${calls_file}" 2>/dev/null || echo 0) + 1))
echo "${calls}" >"${calls_file}"

print_process() {
  printf 'p%s\nc%s\nfcwd\nn%s\n' "$1" "$2" "$3"
}

print_process 424240 caffeinate "${FAKE_LSOF_WORKSPACE}"
print_process 424241 xcodebuild "${FAKE_LSOF_WORKSPACE}-other"
print_process 424243 xcodebuild-helper "${FAKE_LSOF_WORKSPACE}"
if ((busy_calls < 0 || calls <= busy_calls)); then
  print_process 424242 xcodebuild "${FAKE_LSOF_WORKSPACE}/log"
fi
